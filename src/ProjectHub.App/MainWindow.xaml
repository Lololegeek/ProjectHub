<Window x:Class="ProjectHub.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:library="using:ProjectHub.App.Views.Library">
    <Grid x:Name="Root" RequestedTheme="Dark" AllowDrop="True" DragOver="Root_DragOver" Drop="Root_Drop"><Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid x:Name="TitleBar" Background="Transparent" Padding="16,0,140,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10"><Image Source="Assets/ProjectHub.png" Width="18" Height="18" Stretch="Uniform"/><TextBlock Text="ProjectHub" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="/  Votre atelier de développement" Style="{StaticResource MutedText}"/></StackPanel></Grid>
        <NavigationView Grid.Row="1" x:Name="Navigation" PaneDisplayMode="Left" OpenPaneLength="194" CompactPaneLength="48" IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="True" SelectionChanged="Navigation_Changed" IsSettingsVisible="True">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Vue d’ensemble" Tag="dashboard" Icon="Home"/>
                <NavigationViewItem Content="Bibliothèque" Tag="all" Icon="Library" IsSelected="True"/>
                <NavigationViewItem Content="Épinglés" Tag="pinned"><NavigationViewItem.Icon><FontIcon Glyph="&#xE718;"/></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Favoris" Tag="favorites" Icon="Favorite"/>
                <NavigationViewItem Content="Récents" Tag="recent" Icon="Clock"/>
                <NavigationViewItemSeparator/>
                <NavigationViewItem Content="Git à vérifier" Tag="dirty"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8AB;"/></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Projets oubliés" Tag="forgotten"><NavigationViewItem.Icon><FontIcon Glyph="&#xE823;"/></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Archivés" Tag="archived" Icon="Folder"/>
                <NavigationViewItem Content="Collections" Tag="collections" Icon="AllApps"/>
                <NavigationViewItemSeparator/>
                <NavigationViewItem Content="Statistiques" Tag="analytics"><NavigationViewItem.Icon><FontIcon Glyph="&#xE9D2;"/></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Tâches" Tag="tasks"><NavigationViewItem.Icon><FontIcon Glyph="&#xE756;"/></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Diagnostics" Tag="diagnostics" Icon="Help"/>
            </NavigationView.MenuItems>
            <Grid Padding="24,18,24,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid x:Name="DashboardStrip" Visibility="Collapsed" Margin="0,0,0,20" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16"><StackPanel><TextBlock Text="{Binding ProjectCount}" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Projets indexés" Style="{StaticResource MutedText}"/></StackPanel></Border>
                    <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16"><StackPanel><TextBlock Text="{Binding DirtyCount}" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Dépôts à vérifier" Style="{StaticResource MutedText}"/></StackPanel></Border>
                    <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16"><StackPanel><TextBlock Text="{Binding TotalSize}" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Espace sur disque" Style="{StaticResource MutedText}"/></StackPanel></Border>
                    <Border Grid.Column="3" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16"><StackPanel><TextBlock Text="{Binding ForgottenCount}" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Projets oubliés" Style="{StaticResource MutedText}"/></StackPanel></Border>
                </Grid>
                <Grid Grid.Row="1"><library:LibraryPage x:Name="Library"/><ContentControl x:Name="PageHost" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/></Grid>
            </Grid>
        </NavigationView>
        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Padding="16,8"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ProgressRing x:Name="ScanRing" Width="16" Height="16" IsActive="{Binding IsScanning}"/><TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><Button Grid.Column="2" Content="Annuler le scan" Click="Cancel_Click" IsEnabled="{Binding IsScanning}" Padding="8,2" FontSize="12"/><Button Grid.Column="3" Content="Ctrl + K" Click="Palette_Click" Padding="8,2" FontSize="12"/></Grid></Border>
    </Grid>
</Window>
