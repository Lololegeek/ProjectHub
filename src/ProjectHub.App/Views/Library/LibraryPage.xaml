<UserControl x:Class="ProjectHub.App.Views.Library.LibraryPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:ProjectHub.App.Controls">
    <UserControl.Resources><controls:ProjectImageConverter x:Key="ProjectImage"/><controls:ColumnWidthConverter x:Key="ColumnWidth"/><controls:ListPathVisibilityConverter x:Key="PathVisibility"/></UserControl.Resources>
    <Grid RowSpacing="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="{Binding PageTitle}" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="{Binding PageSubtitle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/></StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Button Content="Ajouter un dossier" Click="AddRoot_Click"/><Button Content="Scanner" Click="Scan_Click" Style="{StaticResource AccentButtonStyle}"/></StackPanel>
        </Grid>
        <Grid Grid.Row="1" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/><ColumnDefinition Width="165"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Text="{Binding Query,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Rechercher un projet…  rust · git:dirty · tag:game" AutomationProperties.Name="Rechercher un projet"/>
            <ComboBox Grid.Column="1" ItemsSource="{Binding Stacks}" SelectedItem="{Binding SelectedStack,Mode=TwoWay}" HorizontalAlignment="Stretch"/>
            <ComboBox Grid.Column="2" x:Name="SortBox" SelectionChanged="Sort_Changed" SelectedIndex="0" HorizontalAlignment="Stretch"><x:String>Activité récente</x:String><x:String>Nom</x:String><x:String>Taille</x:String><x:String>Lignes de code</x:String></ComboBox>
            <ComboBox Grid.Column="3" x:Name="ModeBox" SelectionChanged="Mode_Changed" SelectedIndex="0"><x:String>Cartes</x:String><x:String>Liste</x:String><x:String>Compact</x:String></ComboBox>
        </Grid>
        <Grid Grid.Row="2">
            <GridView x:Name="Cards" ItemsSource="{Binding VisibleProjects}" IsItemClickEnabled="True" ItemClick="Project_Click" SelectionMode="None" HorizontalAlignment="Stretch">
                <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="12"/></ItemsPanelTemplate></GridView.ItemsPanel>
                <GridView.ItemTemplate><DataTemplate>
                    <Border Width="260" Height="218" Padding="18" Margin="0,0,8,8" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Border.ContextFlyout><MenuFlyout><MenuFlyoutItem Text="Détails du projet" Tag="{Binding}" Click="DetailsMenu_Click"/><MenuFlyoutItem Text="Ouvrir dans l’éditeur" Tag="{Binding}" Click="EditorMenu_Click"/><MenuFlyoutItem Text="Lancer une commande…" Tag="{Binding}" Click="RunMenu_Click"/><MenuFlyoutItem Text="Terminal" Tag="{Binding}" Click="TerminalMenu_Click"/><MenuFlyoutItem Text="Ouvrir le dossier" Tag="{Binding}" Click="FolderMenu_Click"/><MenuFlyoutSeparator/><MenuFlyoutItem Text="Favori / retirer" Tag="{Binding}" Click="FavoriteMenu_Click"/><MenuFlyoutItem Text="Épingler / retirer" Tag="{Binding}" Click="PinMenu_Click"/><MenuFlyoutItem Text="GitHub" Tag="{Binding}" Click="GitHubMenu_Click"/><MenuFlyoutItem Text="Réanalyser" Tag="{Binding}" Click="RescanMenu_Click"/></MenuFlyout></Border.ContextFlyout>
                        <Grid RowSpacing="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid><Border Width="42" Height="42" CornerRadius="8" HorizontalAlignment="Left" Background="#27354D"><Grid><TextBlock Text="{Binding Initials}" FontWeight="SemiBold" Foreground="#B8CDF8" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding ImagePath,Converter={StaticResource ProjectImage}}" Stretch="UniformToFill"/></Grid></Border><Button Content="{Binding FavoriteLabel}" Tag="{Binding}" Click="Favorite_Click" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" FontSize="19"/></Grid>
                            <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Row="2" Text="{Binding Stack}" Style="{StaticResource MutedText}" TextWrapping="Wrap" MaxLines="2"/>
                            <Grid Grid.Row="3"><TextBlock Text="{Binding GitLabel}" FontSize="12" Foreground="{StaticResource HubAccent}"/><TextBlock Text="{Binding SizeLabel}" FontSize="12" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></Grid>
                            <Grid Grid.Row="4"><TextBlock Text="{Binding BranchLabel}" Style="{StaticResource MutedText}" MaxWidth="120" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left"/><TextBlock Text="{Binding ActivityLabel}" Style="{StaticResource MutedText}" HorizontalAlignment="Right"/></Grid>
                        </Grid>
                    </Border>
                </DataTemplate></GridView.ItemTemplate>
            </GridView>
            <ListView x:Name="Rows" Visibility="Collapsed" ItemsSource="{Binding VisibleProjects}" IsItemClickEnabled="True" ItemClick="Project_Click" SelectionMode="None" HorizontalContentAlignment="Stretch">
                <ListView.ItemTemplate><DataTemplate><Grid Padding="10,4" ColumnSpacing="12"><Grid.ContextFlyout><MenuFlyout><MenuFlyoutItem Text="Détails du projet" Tag="{Binding}" Click="DetailsMenu_Click"/><MenuFlyoutItem Text="Ouvrir dans l’éditeur" Tag="{Binding}" Click="EditorMenu_Click"/><MenuFlyoutItem Text="Lancer une commande…" Tag="{Binding}" Click="RunMenu_Click"/><MenuFlyoutItem Text="Terminal" Tag="{Binding}" Click="TerminalMenu_Click"/><MenuFlyoutItem Text="Ouvrir le dossier" Tag="{Binding}" Click="FolderMenu_Click"/><MenuFlyoutSeparator/><MenuFlyoutItem Text="Favori / retirer" Tag="{Binding}" Click="FavoriteMenu_Click"/><MenuFlyoutItem Text="Épingler / retirer" Tag="{Binding}" Click="PinMenu_Click"/><MenuFlyoutItem Text="GitHub" Tag="{Binding}" Click="GitHubMenu_Click"/><MenuFlyoutItem Text="Réanalyser" Tag="{Binding}" Click="RescanMenu_Click"/></MenuFlyout></Grid.ContextFlyout><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="{Binding Converter={StaticResource ColumnWidth},ConverterParameter=Stack}"/><ColumnDefinition Width="{Binding Converter={StaticResource ColumnWidth},ConverterParameter=Git}"/><ColumnDefinition Width="{Binding Converter={StaticResource ColumnWidth},ConverterParameter=Size}"/><ColumnDefinition Width="{Binding Converter={StaticResource ColumnWidth},ConverterParameter=Activity}"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Initials}" Foreground="{StaticResource HubAccent}"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Path}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" Visibility="{Binding Converter={StaticResource PathVisibility}}"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding Stack}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><TextBlock Grid.Column="3" Text="{Binding GitLabel}" Foreground="{StaticResource HubAccent}" VerticalAlignment="Center"/><TextBlock Grid.Column="4" Text="{Binding SizeLabel}" VerticalAlignment="Center"/><TextBlock Grid.Column="5" Text="{Binding ActivityLabel}" Style="{StaticResource MutedText}" VerticalAlignment="Center"/></Grid></DataTemplate></ListView.ItemTemplate>
            </ListView>
            <StackPanel x:Name="Empty" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"><FontIcon Glyph="&#xE8B7;" FontSize="42" Foreground="{StaticResource HubAccent}"/><TextBlock x:Name="EmptyHeading" Text="Votre bibliothèque commence ici" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock x:Name="EmptyText" Text="Ajoutez un dossier racine. ProjectHub trouvera les projets qu’il contient." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxWidth="390" TextAlignment="Center"/><Button Content="Ajouter un dossier" Click="AddRoot_Click" HorizontalAlignment="Center"/></StackPanel>
        </Grid>
        <TextBlock Grid.Row="3" Text="{Binding Summary}" Style="{StaticResource MutedText}"/>
    </Grid>
</UserControl>
