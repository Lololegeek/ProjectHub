<UserControl x:Class="ProjectHub.App.Views.Settings.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:ProjectHub.App.Controls">
    <Grid RowSpacing="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Spacing="4"><TextBlock Text="Paramètres" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Votre bibliothèque, à votre façon." Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
        <InfoBar x:Name="Feedback" Grid.Row="1" IsOpen="False" IsClosable="True"/>
        <Pivot HorizontalContentAlignment="Stretch" x:Name="Sections" Grid.Row="2">
            <PivotItem HorizontalContentAlignment="Stretch" Header="Dossiers et scan">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"><StackPanel Spacing="10" HorizontalAlignment="Stretch" Padding="0,12,12,20">
                    <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="4"><TextBlock Text="Dossiers surveillés" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="ProjectHub détecte automatiquement les projets dans ces dossiers." Style="{StaticResource MutedText}"/></StackPanel><Button Grid.Column="1" Content="Ajouter un dossier" Click="AddRoot_Click" VerticalAlignment="Center"/></Grid>
                    <ListView x:Name="RootsList" ItemsSource="{Binding Roots}" SelectionMode="None" MaxHeight="240" HorizontalContentAlignment="Stretch">
                        <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/></Style></ListView.ItemContainerStyle>
                        <ListView.ItemTemplate><DataTemplate><Border CornerRadius="6" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE8B7;" FontSize="18" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding}" FontFamily="Cascadia Mono" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTipService.ToolTip="{Binding}"/><Button Grid.Column="2" Tag="{Binding}" Click="RemoveRoot_Click" ToolTipService.ToolTip="Retirer de la surveillance" AutomationProperties.Name="Retirer ce dossier" Background="Transparent" BorderThickness="0"><FontIcon Glyph="&#xE74D;" FontSize="14"/></Button></Grid></Border></DataTemplate></ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="EmptyRoots" Text="Aucun dossier ajouté. Choisissez un dossier contenant vos projets." Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="12,0" TextWrapping="Wrap"/>
                    <TextBlock Text="Surveillance" Style="{StaticResource SectionHeading}" Margin="0,18,0,2"/>
                    <controls:SettingRow Title="Suivre les modifications" Description="Actualiser l’activité et les informations des projets quand leurs fichiers changent." Glyph="&#xE895;"><controls:SettingRow.Editor><ToggleSwitch IsOn="{Binding Draft.WatchEnabled,Mode=TwoWay}" Toggled="Changed" OnContent="Activé" OffContent="Désactivé" AutomationProperties.Name="Suivre les modifications"/></controls:SettingRow.Editor></controls:SettingRow>
                    <controls:SettingRow Title="Découvrir les nouveaux projets" Description="Indexer les projets ajoutés aux dossiers surveillés en arrière-plan." Glyph="&#xE721;"><controls:SettingRow.Editor><ToggleSwitch IsOn="{Binding Draft.BackgroundScan,Mode=TwoWay}" Toggled="Changed" OnContent="Activé" OffContent="Désactivé" AutomationProperties.Name="Découvrir les nouveaux projets"/></controls:SettingRow.Editor></controls:SettingRow>
                    <controls:SettingRow Title="Inclure les dossiers cachés" Description="Rechercher aussi les projets dans les dossiers cachés." Glyph="&#xE890;"><controls:SettingRow.Editor><ToggleSwitch IsOn="{Binding Draft.IncludeHidden,Mode=TwoWay}" Toggled="Changed" OnContent="Activé" OffContent="Désactivé" AutomationProperties.Name="Inclure les dossiers cachés"/></controls:SettingRow.Editor></controls:SettingRow>
                    <Expander Header="Exclusions et options avancées" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,8,0,0">
                        <StackPanel Spacing="12"><TextBlock Text="Dossiers exclus" FontWeight="SemiBold"/><TextBlock Text="Un nom par ligne. Les exclusions s’appliquent à l’intérieur de chaque racine." Style="{StaticResource MutedText}"/><TextBox x:Name="Exclusions" AcceptsReturn="True" TextWrapping="Wrap" Height="150" FontFamily="Cascadia Mono" FontSize="12" TextChanged="TextChanged" AutomationProperties.Name="Dossiers exclus"/>
                            <controls:SettingRow Title="Profondeur maximale" Description="Nombre de niveaux de dossiers parcourus lors de la découverte." Glyph="&#xE8B7;"><controls:SettingRow.Editor><NumberBox x:Name="Depth" Width="140" Minimum="1" Maximum="64" SpinButtonPlacementMode="Inline" ValueChanged="NumberChanged" AutomationProperties.Name="Profondeur maximale"/></controls:SettingRow.Editor></controls:SettingRow>
                            <controls:SettingRow Title="Suivre les liens symboliques" Description="Parcourir les dossiers liés en évitant les boucles." Glyph="&#xE71B;"><controls:SettingRow.Editor><ToggleSwitch IsOn="{Binding Draft.FollowSymlinks,Mode=TwoWay}" Toggled="Changed" OnContent="Activé" OffContent="Désactivé" AutomationProperties.Name="Suivre les liens symboliques"/></controls:SettingRow.Editor></controls:SettingRow>
                        </StackPanel>
                    </Expander>
                </StackPanel></ScrollViewer>
            </PivotItem>
            <PivotItem HorizontalContentAlignment="Stretch" Header="Apparence">
                <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"><StackPanel Spacing="10" Padding="0,12,12,20">
                    <TextBlock Text="Interface" Style="{StaticResource SectionHeading}"/>
                    <controls:SettingRow Title="Langue" Description="Langue utilisée dans l’interface de ProjectHub." Glyph="&#xE774;"><controls:SettingRow.Editor><ComboBox x:Name="LanguageSelector" Width="190" SelectionChanged="ChoiceChanged" AutomationProperties.Name="Langue"><ComboBoxItem Content="Français" Tag="fr"/><ComboBoxItem Content="English" Tag="en"/></ComboBox></controls:SettingRow.Editor></controls:SettingRow>
                    <controls:SettingRow Title="Thème" Description="Choisir l’apparence de ProjectHub ou suivre celle de Windows." Glyph="&#xE790;"><controls:SettingRow.Editor><ComboBox x:Name="Theme" Width="190" SelectionChanged="ChoiceChanged" AutomationProperties.Name="Thème"><ComboBoxItem Content="Sombre" Tag="Dark"/><ComboBoxItem Content="Clair" Tag="Light"/><ComboBoxItem Content="Système" Tag="System"/></ComboBox></controls:SettingRow.Editor></controls:SettingRow>
                    <TextBlock Text="Colonnes de la bibliothèque" Style="{StaticResource SectionHeading}" Margin="0,20,0,4"/><TextBlock Text="Choisir les informations affichées dans les modes Liste et Compact." Style="{StaticResource MutedText}"/>
                    <Border Padding="18" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><StackPanel x:Name="Columns" Orientation="Horizontal" Spacing="22"><CheckBox x:Name="StackColumn" Content="Stack" Click="Changed"/><CheckBox x:Name="GitColumn" Content="État Git" Click="Changed"/><CheckBox x:Name="SizeColumn" Content="Taille" Click="Changed"/><CheckBox x:Name="ActivityColumn" Content="Activité" Click="Changed"/><CheckBox x:Name="PathColumn" Content="Chemin" Click="Changed"/></StackPanel></Border>
                </StackPanel></ScrollViewer>
            </PivotItem>
            <PivotItem HorizontalContentAlignment="Stretch" Header="Éditeurs et Git">
                <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"><StackPanel Spacing="10" Padding="0,12,12,20">
                    <controls:SettingRow Title="Éditeur préféré" Description="Utilisé par l’action Ouvrir. Le mode automatique choisit un outil disponible." Glyph="&#xE70F;"><controls:SettingRow.Editor><ComboBox x:Name="PreferredEditor" ItemsSource="{Binding Editors}" Width="210" SelectionChanged="ChoiceChanged" AutomationProperties.Name="Éditeur préféré"/></controls:SettingRow.Editor></controls:SettingRow>
                    <Grid Margin="0,18,0,4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Outils disponibles" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Grid.Column="1" Content="Actualiser" Click="RefreshTools_Click"/></Grid>
                    <ItemsControl x:Name="ToolList" ItemsSource="{Binding Tools}"><ItemsControl.ItemTemplate><DataTemplate><Border Padding="16,12" Margin="0,0,0,6" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><StackPanel Spacing="4"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Executable}" FontFamily="Cascadia Mono" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    <TextBlock x:Name="EmptyTools" Text="Aucun outil détecté. Ajoutez le chemin de votre éditeur ou moteur ci-dessous." Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
                    <Expander Header="Configurer un outil" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><StackPanel Spacing="12"><TextBox x:Name="ToolName" Header="Nom" PlaceholderText="Godot, Rider, VS Code…"/><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ToolPath" Header="Exécutable" PlaceholderText="Chemin du fichier .exe"/><Button Grid.Column="1" Content="Parcourir…" Click="BrowseTool_Click" VerticalAlignment="Bottom"/></Grid><Button Content="Ajouter l’outil" Click="ConfigureTool_Click" HorizontalAlignment="Left"/></StackPanel></Expander>
                    <TextBlock Text="Git" Style="{StaticResource SectionHeading}" Margin="0,18,0,4"/>
                    <controls:SettingRow Title="Exécutable Git" Description="Nom de la commande ou chemin complet de l’exécutable." Glyph="&#xE8AB;"><controls:SettingRow.Editor><TextBox Text="{Binding Draft.GitExecutable,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" TextChanged="TextChanged" Width="260" AutomationProperties.Name="Exécutable Git"/></controls:SettingRow.Editor></controls:SettingRow>
                    <controls:SettingRow Title="Rafraîchissement Git" Description="Intervalle entre les lectures de l’état des dépôts, en secondes." Glyph="&#xE787;"><controls:SettingRow.Editor><NumberBox x:Name="GitInterval" Width="140" Minimum="30" Maximum="3600" SpinButtonPlacementMode="Inline" ValueChanged="NumberChanged" AutomationProperties.Name="Rafraîchissement Git"/></controls:SettingRow.Editor></controls:SettingRow>
                </StackPanel></ScrollViewer>
            </PivotItem>
            <PivotItem HorizontalContentAlignment="Stretch" Header="Fonctionnement">
                <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"><StackPanel Spacing="10" Padding="0,12,12,20">
                    <TextBlock Text="Accès rapide" Style="{StaticResource SectionHeading}"/>
                    <controls:SettingRow Title="Zone de notification" Description="Garder ProjectHub accessible après la fermeture de sa fenêtre." Glyph="&#xE73C;"><controls:SettingRow.Editor><ToggleSwitch IsOn="{Binding Draft.TrayEnabled,Mode=TwoWay}" Toggled="Changed" OnContent="Activé" OffContent="Désactivé" AutomationProperties.Name="Zone de notification"/></controls:SettingRow.Editor></controls:SettingRow>
                    <controls:SettingRow Title="Raccourci global" Description="Ouvrir la recherche depuis n’importe quelle application." Glyph="&#xE765;"><controls:SettingRow.Editor><ToggleSwitch x:Name="HotkeyToggle" IsOn="{Binding Draft.HotkeyEnabled,Mode=TwoWay}" Toggled="Changed" OnContent="Activé" OffContent="Désactivé" AutomationProperties.Name="Raccourci global"/></controls:SettingRow.Editor></controls:SettingRow>
                    <controls:SettingRow Title="Touche du raccourci" Description="Combinaison Ctrl + Alt + la touche choisie." Glyph="&#xE765;"><controls:SettingRow.Editor><TextBox x:Name="Hotkey" Width="80" MaxLength="1" TextAlignment="Center" IsEnabled="{Binding IsOn,ElementName=HotkeyToggle}" TextChanged="TextChanged" AutomationProperties.Name="Touche du raccourci"/></controls:SettingRow.Editor></controls:SettingRow>
                    <TextBlock Text="Performance du scan" Style="{StaticResource SectionHeading}" Margin="0,18,0,4"/>
                    <controls:SettingRow Title="Analyses simultanées" Description="Limiter le nombre de projets analysés en parallèle." Glyph="&#xE9D9;"><controls:SettingRow.Editor><NumberBox x:Name="Concurrency" Width="140" Minimum="1" Maximum="8" SpinButtonPlacementMode="Inline" ValueChanged="NumberChanged" AutomationProperties.Name="Analyses simultanées"/></controls:SettingRow.Editor></controls:SettingRow>
                    <controls:SettingRow Title="Budget par projet" Description="Durée maximale de l’analyse, en secondes. 0 signifie illimité." Glyph="&#xE916;"><controls:SettingRow.Editor><NumberBox x:Name="Budget" Width="140" Minimum="0" Maximum="3600" SpinButtonPlacementMode="Inline" ValueChanged="NumberChanged" AutomationProperties.Name="Budget par projet"/></controls:SettingRow.Editor></controls:SettingRow>
                </StackPanel></ScrollViewer>
            </PivotItem>
            <PivotItem HorizontalContentAlignment="Stretch" Header="Configuration">
                <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"><StackPanel Spacing="10" Padding="0,12,12,20">
                    <controls:SettingRow Title="Exporter la configuration" Description="Sauvegarder vos dossiers, préférences, tags, collections et notes dans un fichier JSON." Glyph="&#xE74E;"><controls:SettingRow.Editor><Button Content="Exporter…" Click="Export_Click"/></controls:SettingRow.Editor></controls:SettingRow>
                    <controls:SettingRow Title="Importer une configuration" Description="Restaurer les préférences et métadonnées d’un fichier ProjectHub." Glyph="&#xE8B5;"><controls:SettingRow.Editor><Button Content="Importer…" Click="Import_Click"/></controls:SettingRow.Editor></controls:SettingRow>
                    <TextBlock Text="Les caches du scan et les fichiers de vos projets ne sont pas exportés." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="18,4"/>
                </StackPanel></ScrollViewer>
            </PivotItem>
        </Pivot>
        <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Padding="0,14,0,0">
            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="SaveState" Text="Tous les paramètres sont enregistrés." Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap"/><Button Grid.Column="1" x:Name="DiscardButton" Content="Annuler les modifications" Click="Discard_Click" IsEnabled="{Binding HasChanges}"/><Button Grid.Column="2" x:Name="SaveButton" Content="Enregistrer" Click="Save_Click" Style="{StaticResource AccentButtonStyle}" IsEnabled="{Binding HasChanges}"/></Grid>
        </Border>
    </Grid>
</UserControl>
