<UserControl x:Class="ProjectHub.App.Views.Details.ProjectDetailsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid RowSpacing="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Spacing="6"><TextBlock Text="{Binding Path}" FontFamily="Cascadia Mono" FontSize="12" IsTextSelectionEnabled="True" TextWrapping="Wrap"/><TextBlock Text="{Binding FullStack}" Foreground="{StaticResource HubAccent}" TextWrapping="Wrap" MaxLines="3"/><TextBlock Text="{Binding Description}" TextWrapping="Wrap" MaxLines="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8"><Button Content="Ouvrir" Click="Open_Click" Style="{StaticResource AccentButtonStyle}"/><ComboBox x:Name="Editors" PlaceholderText="Choisir un éditeur" Width="165" DisplayMemberPath="Name" SelectionChanged="Editor_Changed"/><Button Content="Terminal" Click="Terminal_Click"/><Button Content="Dossier" Click="Folder_Click"/><Button x:Name="GitHubButton" Content="GitHub" Click="GitHub_Click"/><Button Content="Actualiser" Click="Refresh_Click"/></StackPanel>
        <TabView x:Name="DetailsTabs" Grid.Row="2" IsAddTabButtonVisible="False" CanDragTabs="False" CanReorderTabs="False">
            <TabViewItem Header="Général" IsClosable="False"><ScrollViewer><StackPanel Spacing="12" Padding="4,16,12,12">
                <TextBlock x:Name="GeneralStats" TextWrapping="Wrap"/><TextBlock x:Name="HealthText" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Spacing="18"><CheckBox x:Name="Favorite" Content="Favori"/><CheckBox x:Name="Pinned" Content="Épinglé"/><CheckBox x:Name="Archived" Content="Archivé"/><NumberBox x:Name="PinOrder" Header="Ordre" Width="90" Minimum="0" SpinButtonPlacementMode="Inline"/></StackPanel>
                <TextBox x:Name="Tags" Header="Tags personnels (séparés par des virgules)"/><TextBlock x:Name="AutoTags" Style="{StaticResource MutedText}"/>
                <TextBox x:Name="Collections" Header="Collections (séparées par des virgules)"/>
                <TextBox x:Name="Notes" Header="Notes personnelles" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100"/>
                <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Choisir une image" Click="Image_Click"/><Button Content="Ajouter un screenshot" Click="Screenshot_Click"/></StackPanel><ItemsControl x:Name="Screenshots"><ItemsControl.ItemTemplate><DataTemplate><Image Source="{Binding}" MaxHeight="200" Stretch="Uniform" Margin="0,4"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <TextBlock Text="Composants" Style="{StaticResource SectionHeading}"/><ItemsControl x:Name="Components"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,4"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Path}" Style="{StaticResource MutedText}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel></ScrollViewer></TabViewItem>
            <TabViewItem Header="Git" IsClosable="False"><ScrollViewer><StackPanel Spacing="10" Padding="4,16,12,12"><TextBlock x:Name="GitSummary" TextWrapping="Wrap" IsTextSelectionEnabled="True"/><TextBlock Text="Fichiers modifiés · index / working tree" FontWeight="SemiBold"/><ListView x:Name="GitChanges" MaxHeight="220" SelectionMode="None"><ListView.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="{Binding Status}" FontFamily="Cascadia Mono"/><TextBlock Text="{Binding Path}"/></StackPanel></DataTemplate></ListView.ItemTemplate></ListView><TextBlock Text="Derniers commits" FontWeight="SemiBold"/><ItemsControl x:Name="Commits"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,6"><TextBlock Text="{Binding Subject}" FontWeight="SemiBold" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="{Binding Author}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding Date}" Style="{StaticResource MutedText}"/></StackPanel></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer></TabViewItem>
            <TabViewItem Header="Code" IsClosable="False"><ScrollViewer><StackPanel Padding="4,16,12,12" Spacing="12"><TextBlock Text="Lignes par langage · classification indicative" FontWeight="SemiBold"/><ItemsControl x:Name="LanguageStats"><ItemsControl.ItemTemplate><DataTemplate><Grid ColumnSpacing="16" Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{Binding Language}"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Code}"/><TextBlock Text="Code" Style="{StaticResource MutedText}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="{Binding Comments}"/><TextBlock Text="Commentaires" Style="{StaticResource MutedText}"/></StackPanel><StackPanel Grid.Column="3"><TextBlock Text="{Binding Blank}"/><TextBlock Text="Vides" Style="{StaticResource MutedText}"/></StackPanel></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock x:Name="TodoSummary"/><ListView x:Name="Todos" IsItemClickEnabled="True" ItemClick="Todo_Click" SelectionMode="None" MaxHeight="340"><ListView.ItemTemplate><DataTemplate><StackPanel Margin="0,4"><TextBlock Text="{Binding Text}" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding Kind}" Foreground="{StaticResource HubAccent}"/><TextBlock Text="{Binding Line}"/><TextBlock Text="{Binding Path}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis"/></StackPanel></StackPanel></DataTemplate></ListView.ItemTemplate></ListView></StackPanel></ScrollViewer></TabViewItem>
            <TabViewItem Header="README" IsClosable="False"><ScrollViewer><StackPanel x:Name="ReadmeHost" Padding="8,16,16,12" Spacing="10"/></ScrollViewer></TabViewItem>
            <TabViewItem Header="Activité" IsClosable="False"><ListView x:Name="Activity" SelectionMode="None"><ListView.ItemTemplate><DataTemplate><StackPanel Margin="0,8"><TextBlock Text="{Binding Description}"/><StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="{Binding Kind}" Foreground="{StaticResource HubAccent}"/><TextBlock Text="{Binding Date}" Style="{StaticResource MutedText}"/></StackPanel></StackPanel></DataTemplate></ListView.ItemTemplate></ListView></TabViewItem>
            <TabViewItem Header="Stockage" IsClosable="False"><ScrollViewer><StackPanel Padding="4,16,12,12" Spacing="12"><TextBlock x:Name="StorageSummary" TextWrapping="Wrap"/><ListView x:Name="Storage" SelectionMode="None" MaxHeight="320"><ListView.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Spacing="18" Margin="0,4"><TextBlock Text="{Binding Name}" Width="210"/><TextBlock Text="{Binding Bytes}"/><TextBlock Text="{Binding Regenerable}" Style="{StaticResource MutedText}"/></StackPanel></DataTemplate></ListView.ItemTemplate></ListView><Button Content="Voir les dossiers régénérables" Click="Cleanup_Click"/><StackPanel x:Name="CleanupReview" Spacing="8"/><TextBlock Text="Les tailles incluent les dépendances. Aucun fichier n’est supprimé automatiquement." Style="{StaticResource MutedText}" TextWrapping="Wrap"/></StackPanel></ScrollViewer></TabViewItem>
            <TabViewItem Header="Lancer" IsClosable="False"><StackPanel Padding="4,16,12,12" Spacing="12"><TextBlock Text="Ces commandes proviennent des manifestes. Elles peuvent exécuter du code du projet." TextWrapping="Wrap"/><ListView x:Name="Commands" IsItemClickEnabled="True" ItemClick="Command_Click" MaxHeight="300" SelectionMode="None"><ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" FontFamily="Cascadia Mono" Margin="4,8"/></DataTemplate></ListView.ItemTemplate></ListView><TextBlock x:Name="CommandStatus" TextWrapping="Wrap" Foreground="{StaticResource HubAccent}"/></StackPanel></TabViewItem>
        </TabView>
    </Grid>
</UserControl>
